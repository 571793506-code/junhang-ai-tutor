# App
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://junhang:junhang@localhost:5432/junhang_ai_tutor
ACCESS_CODE_PEPPER=change-this-before-production

# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_WEBHOOK=
FEISHU_BOT_SIGN_SECRET=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
DEEPSEEK_ASSESSMENT_MODEL=deepseek-v4-pro
DEEPSEEK_ASSESSMENT_FALLBACK_MODEL=deepseek-v4-pro
DEEPSEEK_ASSESSMENT_TIMEOUT_MS=180000

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_T2A_BASE_URL=https://api.minimaxi.com
MINIMAX_SPEECH_MODEL=speech-2.8-turbo
MINIMAX_BALANCE_STATUS=restored

# Optional live provider checks
AI_SMOKE_TEST=0

# GPT5.5 / premium review gate
GPT55_API_KEY=
GPT55_BASE_URL=
GPT55_MODEL=gpt-5.5
GPT55_REVIEW_TIMEOUT_MS=180000

# OCR / image recognition
# manual: unavailable with clear fallback; mock: local demo; tesseract: local OCR;
# http: call OCR_HTTP_URL; vision: OpenAI-compatible image understanding/OCR model.
OCR_ENABLED=true
OCR_ENGINE=vision
OCR_VISION_PROVIDER=minimax
OCR_VISION_BASE_URL=
OCR_VISION_API_KEY=
OCR_VISION_MODEL=coding_plan/vlm
OCR_TESSERACT_LANG=chi_sim+eng
OCR_HTTP_URL=
OCR_HTTP_API_KEY=
GRADING_REQUIRE_SECOND_MODEL_AUDIT=true
GRADING_REQUIRE_PREMIUM_JUDGE=true

# GitHub
# 本项目当前使用 Git over SSH 连接 GitHub，`gh` 登录态存放在系统凭据管理器中。
# 不要把真实 GitHub token 写入或提交到项目文件。
GITHUB_REPOSITORY=571793506-code/junhang-ai-tutor
GITHUB_REMOTE_URL=git@github.com:571793506-code/junhang-ai-tutor.git
GITHUB_DEFAULT_BRANCH=main
GITHUB_CLI_HOST=github.com
GITHUB_CLI_ACCOUNT=571793506-code
GITHUB_TOKEN=
GITHUB_KEY_FINGERPRINT=
