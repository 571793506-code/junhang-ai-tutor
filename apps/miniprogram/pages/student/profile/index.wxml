<view class="page student-page">
  <view class="hero">
    <text class="eyebrow">学生档案</text>
    <text class="title">{{student.displayName || '学生'}}近期学习记录</text>
    <text class="subtitle">家长可查看知识掌握、错题记录和阶段反馈。</text>
  </view>

  <view class="card">
    <text class="section-title">阶段反馈</text>
    <text wx:if="{{publishedProfileText}}" class="published-profile">{{publishedProfileText}}</text>
    <text wx:if="{{!publishedProfileText && !loading}}" class="muted">{{profileMessage || '老师还未发布阶段反馈。'}}</text>
  </view>

  <view class="card">
    <text class="section-title">期中/期末报告</text>
    <view class="list">
      <view wx:for="{{sentTermReports}}" wx:key="id" class="term-report-card">
        <view>
          <text class="item-title">{{item.displayPeriod}}</text>
          <text class="item-meta">老师已发送阶段报告给家长</text>
          <text wx:if="{{item.sentTimeText}}" class="item-meta">发送日期：{{item.sentTimeText}}</text>
        </view>
        <text class="status-pill">已发送</text>
      </view>
    </view>
    <text wx:if="{{!sentTermReports.length && !loading}}" class="muted">暂无已发送的期中/期末报告。</text>
  </view>

  <view class="card">
    <text class="section-title">知识掌握</text>
    <view wx:for="{{subjects}}" wx:key="name" class="mastery-row">
      <text class="item-title">{{item.name}}</text>
      <view class="mastery-bar">
        <view class="mastery-fill" style="width: {{item.value}}%;"></view>
      </view>
      <text class="item-meta">{{item.value}}%</text>
    </view>
  </view>

  <view class="card">
    <text class="section-title">错题记录</text>
    <view class="list">
      <view wx:for="{{corrections}}" wx:key="id" class="list-item">
        <text class="item-title">{{item.subject}} · {{item.point}}</text>
        <text class="item-meta">{{item.prompt}}</text>
      </view>
    </view>
    <text wx:if="{{!corrections.length}}" class="muted">暂时没有新的错题记录。</text>
  </view>

  <view class="card">
    <text class="section-title">历史反馈</text>
    <view class="list">
      <view wx:for="{{reports}}" wx:key="id" class="list-item">
        <text class="item-title">{{item.period}} · {{item.title}}</text>
        <text class="item-meta">{{item.summary}}</text>
      </view>
    </view>
    <text wx:if="{{!reports.length && !loading}}" class="muted">暂无历史阶段反馈。</text>
  </view>
</view>
