.mastery-row {
  margin-top: 18rpx;
}

.mastery-bar {
  height: 18rpx;
  margin: 12rpx 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dcebe6;
}

.mastery-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2f9d7e, #77c7ac);
}

.published-profile {
  display: block;
  margin-top: 12rpx;
  color: #344054;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.term-report-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(99, 124, 113, 0.12);
}

.term-report-card:last-child {
  border-bottom: 0;
}

.status-pill {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e7f6ef;
  color: #238161;
  font-size: 22rpx;
  font-weight: 900;
}
