<view class="page teacher-page">
  <view class="hero">
    <text class="eyebrow">批改工作台</text>
    <text class="title">逐题复核详情</text>
    <text class="subtitle">本页只展示服务端识别、置信度和复核状态。教师确认前不写入学生档案。</text>
  </view>

  <view class="card teacher-card">
    <view class="row between">
      <text class="section-title">{{summary.title || '批改详情'}}</text>
      <text class="pill">{{summary.statusText || '待加载'}}</text>
    </view>
    <view class="detail-grid">
      <text>分数：{{summary.scoreText || '待确认'}}</text>
      <text>质量：{{summary.qualityText || '待检查'}}</text>
      <text>待确认：{{summary.pendingText || '0题待确认'}}</text>
    </view>
    <text wx:if="{{message}}" class="subtitle">{{message}}</text>
  </view>

  <view class="card teacher-card">
    <text class="section-title">教师确认归档</text>
    <text class="muted">只提交教师确认后的分数和备注。低置信、待复核或人工调整结果仍由服务端决定是否允许归档。</text>
    <input class="input" type="digit" placeholder="教师确认分数" value="{{reviewScore}}" bindinput="setReviewScore" />
    <textarea class="textarea review-note" placeholder="复核备注，可填写低置信题号、调整原因或后续练习建议。" value="{{reviewNote}}" bindinput="setReviewNote" />
    <button class="button warm" loading="{{archiveLoading}}" bindtap="submitArchive">确认归档</button>
    <text wx:if="{{archiveMessage}}" class="subtitle">{{archiveMessage}}</text>
  </view>

  <view class="card teacher-card">
    <text class="section-title">图片页</text>
    <block wx:for="{{pages}}" wx:key="id">
      <view class="detail-row">
        <text class="row-title">{{item.title}} · {{item.qualityText}}</text>
        <text class="row-meta">质量分：{{item.scoreText}}</text>
        <text class="row-meta">{{item.issuesText}}</text>
      </view>
    </block>
    <text wx:if="{{!pages.length && !loading}}" class="muted">暂无图片页信息。</text>
  </view>

  <view class="card teacher-card">
    <text class="section-title">逐题结果</text>
    <view class="question-review-box">
      <text class="field-title">{{questionReview.title}}</text>
      <text class="muted">选择题目后填写老师确认得分和必要修正。提交后服务端会重新标记为待教师确认，不自动归档。</text>
      <picker mode="selector" range="{{questionStatusNames}}" value="{{questionStatusIndex}}" bindchange="setQuestionStatus">
        <view class="picker-field">题目状态：{{questionStatusNames[questionStatusIndex]}}</view>
      </picker>
      <view class="review-score-grid">
        <input class="input" type="digit" placeholder="确认得分" value="{{questionReview.score}}" data-field="score" bindinput="setQuestionReviewField" />
        <input class="input" type="digit" placeholder="该题满分" value="{{questionReview.maxScore}}" data-field="maxScore" bindinput="setQuestionReviewField" />
      </view>
      <textarea class="textarea review-note" placeholder="学生作答修正，可不填" value="{{questionReview.studentAnswer}}" data-field="studentAnswer" bindinput="setQuestionReviewField" />
      <textarea class="textarea review-note" placeholder="参考答案修正，可不填" value="{{questionReview.correctAnswer}}" data-field="correctAnswer" bindinput="setQuestionReviewField" />
      <textarea class="textarea review-note" placeholder="该题复核备注，可填写扣分原因或后续练习建议。" value="{{questionReview.teacherNote}}" data-field="teacherNote" bindinput="setQuestionReviewField" />
      <button class="button secondary" loading="{{questionReviewSubmitting}}" bindtap="submitQuestionReview">提交该题修正</button>
      <text wx:if="{{questionReviewMessage}}" class="subtitle">{{questionReviewMessage}}</text>
    </view>
    <block wx:for="{{questions}}" wx:key="id">
      <view class="question-row">
        <view class="row between">
          <text class="row-title">第 {{item.questionNo}} 题</text>
          <text class="pill">{{item.statusLabel}}</text>
        </view>
        <text class="row-meta">得分：{{item.scoreText}} · 置信度：{{item.confidenceText}}</text>
        <text class="field-title">学生作答</text>
        <text class="row-body">{{item.studentAnswer}}</text>
        <text class="field-title">参考答案</text>
        <text class="row-body">{{item.correctAnswer}}</text>
        <text class="field-title">错误步骤</text>
        <text class="row-body">{{item.errorStep}}</text>
        <text class="field-title">解析</text>
        <text class="row-body">{{item.explanation}}</text>
        <text class="row-meta">知识点：{{item.knowledgePoint}}</text>
        <button class="small-button review-button" data-id="{{item.id}}" bindtap="startQuestionReview">复核此题</button>
      </view>
    </block>
    <text wx:if="{{!questions.length && !loading}}" class="muted">暂无逐题结果。</text>
  </view>
</view>
