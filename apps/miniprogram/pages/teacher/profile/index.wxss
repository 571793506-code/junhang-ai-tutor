.profile-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef6ff 0%, #f8fbff 58%, #ffffff 100%);
  color: #172033;
}

.profile-hero {
  padding: 34rpx 0 20rpx;
}

.kicker {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e4f0ff;
  color: #1d4f91;
  font-size: 23rpx;
  font-weight: 900;
}

.title {
  display: block;
  margin-top: 18rpx;
  color: #12345f;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
}

.subtitle,
.panel-subtitle,
.message {
  display: block;
  color: #607488;
  font-size: 24rpx;
  line-height: 1.45;
}

.subtitle {
  margin-top: 12rpx;
}

.profile-panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(75, 117, 176, 0.14);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 42rpx rgba(20, 49, 87, 0.08);
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-title {
  display: block;
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
}

.panel-subtitle {
  margin-top: 8rpx;
}

.panel-tag,
.ai-generated-badge {
  flex: 0 0 auto;
  min-height: 42rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f1ff;
  color: #1d4f91;
  font-size: 23rpx;
  font-weight: 900;
}

.picker-field,
.profile-textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 18rpx;
  border: 1rpx solid rgba(75, 117, 176, 0.18);
  border-radius: 16rpx;
  background: #fff;
  color: #172033;
  font-size: 25rpx;
}

.picker-field {
  min-height: 78rpx;
  padding: 20rpx;
}

.profile-textarea {
  min-height: 720rpx;
  padding: 22rpx;
  line-height: 1.55;
}

.button-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.primary-button,
.secondary-button {
  margin: 0;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.primary-button {
  background: linear-gradient(135deg, #2f75f6, #63a4ff);
  color: #fff;
}

.secondary-button {
  background: #e8f1ff;
  color: #1d4f91;
}

.message {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #eef6ff;
  color: #1d4f91;
}

.term-report-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #eef6ff;
}

.term-report-switch button {
  margin: 0;
  border-radius: 14rpx;
  background: transparent;
  color: #456073;
  font-size: 24rpx;
  font-weight: 900;
}

.term-report-switch button.active {
  background: #ffffff;
  color: #1d4f91;
  box-shadow: 0 8rpx 20rpx rgba(29, 79, 145, 0.12);
}

.term-report-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(75, 117, 176, 0.18);
  border-radius: 16rpx;
  background: #fff;
  color: #172033;
  font-size: 25rpx;
}

.term-report-textarea {
  min-height: 560rpx;
}

.term-report-asset,
.term-report-row {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(75, 117, 176, 0.12);
}

.term-report-list {
  margin-top: 18rpx;
}

.item-title,
.item-meta,
.context-note {
  display: block;
}

.item-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.item-meta,
.context-note {
  margin-top: 8rpx;
  color: #607488;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}
