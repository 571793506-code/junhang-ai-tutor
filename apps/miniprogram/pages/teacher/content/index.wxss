.content-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef6ff 0%, #f8fbff 58%, #ffffff 100%);
  color: #172033;
}

.content-hero { padding: 34rpx 0 20rpx; }

.kicker {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e4f0ff;
  color: #1d4f91;
  font-size: 23rpx;
  font-weight: 900;
}

.title {
  display: block;
  margin-top: 18rpx;
  color: #12345f;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #607488;
  font-size: 25rpx;
  line-height: 1.45;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stat-card,
.content-panel {
  border: 1rpx solid rgba(75, 117, 176, 0.14);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 42rpx rgba(20, 49, 87, 0.08);
}

.stat-card { padding: 22rpx; }
.stat-card.warn { background: #fffaf0; }

.stat-value {
  display: block;
  color: #1d4f91;
  font-size: 42rpx;
  font-weight: 900;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  color: #607488;
  font-size: 23rpx;
}

.content-panel {
  margin-top: 20rpx;
  padding: 24rpx;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-title {
  display: block;
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
}

.panel-subtitle,
.source-meta,
.source-summary,
.index-note,
.empty {
  display: block;
  color: #607488;
  font-size: 24rpx;
  line-height: 1.45;
}

.panel-subtitle { margin-top: 8rpx; }

.index-note {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f5f9ff;
}

.picker-field,
.field,
.textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 16rpx;
  border: 1rpx solid rgba(75, 117, 176, 0.18);
  border-radius: 16rpx;
  background: #fff;
  color: #172033;
  font-size: 25rpx;
}

.picker-field,
.field {
  min-height: 78rpx;
  padding: 20rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 20rpx;
  line-height: 1.45;
}

.primary-button,
.small-button {
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.primary-button {
  margin-top: 18rpx;
  background: linear-gradient(135deg, #2f75f6, #63a4ff);
  color: #fff;
}

.primary-button.secondary {
  background: #e8f1ff;
  color: #1d4f91;
}

.button-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.small-button {
  min-width: 118rpx;
  margin: 0;
  background: #e8f1ff;
  color: #1d4f91;
}

.small-button.ghost {
  background: #f3f6fa;
  color: #607488;
}

.source-card {
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(75, 117, 176, 0.14);
  border-radius: 18rpx;
  background: #f7fbff;
}

.source-title {
  display: block;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.source-meta,
.source-summary { margin-top: 8rpx; }

.source-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.empty { margin-top: 18rpx; }

.message {
  margin: 20rpx 0 10rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #e8f1ff;
  color: #1d4f91;
  font-size: 24rpx;
  line-height: 1.45;
}
