.picker-field,
.textarea {
  color: #172033;
}

.ai-generated-badge {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: rgba(208, 232, 255, 0.2);
  color: #eaf5ff;
  font-size: 23rpx;
  font-weight: 800;
}

.action-row {
  gap: 16rpx;
  margin-top: 18rpx;
}

.ghost-button {
  min-height: 76rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(107, 141, 255, 0.28);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #24417b;
  font-size: 26rpx;
  font-weight: 800;
}

.ghost-button.danger {
  color: #9a3412;
  border-color: rgba(234, 88, 12, 0.24);
}
