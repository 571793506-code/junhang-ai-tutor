.picker-field,
.textarea {
  color: #172033;
}

.ai-generated-badge {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: rgba(208, 232, 255, 0.2);
  color: #eaf5ff;
  font-size: 23rpx;
  font-weight: 800;
}

.action-row {
  gap: 16rpx;
  margin-top: 18rpx;
}

.ghost-button {
  min-height: 76rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(107, 141, 255, 0.28);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #24417b;
  font-size: 26rpx;
  font-weight: 800;
}

.ghost-button.danger {
  color: #9a3412;
  border-color: rgba(234, 88, 12, 0.24);
}

.generation-evidence {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(36, 65, 123, 0.14);
  border-radius: 12rpx;
  background: rgba(240, 246, 255, 0.7);
}

.field-title,
.job-title,
.job-meta {
  display: block;
}

.field-title {
  margin: 12rpx 0 8rpx;
  color: #24417b;
  font-size: 24rpx;
  font-weight: 800;
}

.generation-job {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(36, 65, 123, 0.12);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
}

.generation-job.active {
  border-color: rgba(36, 65, 123, 0.42);
  background: rgba(227, 239, 255, 0.82);
}

.job-title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 800;
}

.job-meta {
  margin-top: 6rpx;
  color: #5d6b82;
  font-size: 23rpx;
}
