.pill {
  background: rgba(204, 232, 255, 0.22);
  color: #d9ecff;
}

.picker-field,
.input,
.textarea {
  color: #172033;
}

.actions {
  margin-top: 16rpx;
}

.mini-button {
  flex: 1;
  min-height: 64rpx;
  margin: 0;
  border-radius: 10rpx;
  background: rgba(208, 232, 255, 0.22);
  color: #fff;
  font-size: 24rpx;
}

.mini-button.danger {
  background: rgba(255, 99, 99, 0.28);
}
