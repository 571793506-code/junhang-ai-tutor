.picker-field,
.input,
.textarea {
  color: #172033;
}

.small-button {
  min-height: 58rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(107, 141, 255, 0.26);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.74);
  color: #24417b;
  font-size: 24rpx;
  font-weight: 800;
}

.workbench-row {
  display: grid;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(107, 141, 255, 0.14);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.7);
}

.workbench-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.workbench-meta {
  color: #667085;
  font-size: 24rpx;
}
