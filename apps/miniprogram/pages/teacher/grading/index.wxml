<view class="page teacher-page">
  <view class="hero">
    <text class="eyebrow">批改复核 · 上传入口</text>
    <text class="title">先绑定学生，再上传批改图片</text>
    <text class="subtitle">上传后进入批改复核队列。教师确认前不写入学生档案。</text>
  </view>

  <view class="card teacher-card">
    <text class="section-title">批改信息</text>
    <picker mode="selector" range="{{studentNames}}" value="{{studentIndex}}" bindchange="setStudent">
      <view class="picker-field">{{studentNames[studentIndex] || '选择学生'}}</view>
    </picker>
    <picker mode="selector" range="{{kinds}}" value="{{kindIndex}}" bindchange="setKind">
      <view class="picker-field">{{kinds[kindIndex]}}</view>
    </picker>
    <picker mode="selector" range="{{subjects}}" value="{{subjectIndex}}" bindchange="setSubject">
      <view class="picker-field">{{subjects[subjectIndex]}}</view>
    </picker>
    <input class="input" type="number" placeholder="页码，可不填" value="{{pageNumber}}" bindinput="setPageNumber" />
    <input class="input" placeholder="题号范围，如 1-6 题 / 听写 1-20" value="{{questionRange}}" bindinput="setQuestionRange" />
    <textarea class="textarea" placeholder="可粘贴 OCR 文本或备注，例如：第三题单位漏写、听写第5个词错误。" value="{{note}}" bindinput="setNote" />
    <button class="button ghost" bindtap="chooseImages">选择图片（{{files.length}}）</button>
    <button class="button" loading="{{loading}}" bindtap="submit">上传并批改</button>
    <text wx:if="{{message}}" class="subtitle">{{message}}</text>
  </view>

  <view class="card teacher-card">
    <view class="row between">
      <text class="section-title">批改工作台</text>
      <button class="small-button" loading="{{loading}}" bindtap="loadWorkbenches">刷新</button>
    </view>
    <text class="muted">只展示服务端复核状态。逐题识别、置信度和归档判断仍由 API 与教师确认流程处理。</text>
    <text wx:if="{{workbenchMessage}}" class="subtitle">{{workbenchMessage}}</text>
    <block wx:for="{{workbenches}}" wx:key="submissionId">
      <view class="workbench-row">
        <text class="workbench-title">{{item.displayTitle}}</text>
        <text class="workbench-meta">{{item.statusText}} · {{item.pendingText}}</text>
        <text class="workbench-meta">{{item.subject}} · {{item.kind || '批改'}} · {{item.qualityText}}</text>
      </view>
    </block>
  </view>
</view>
