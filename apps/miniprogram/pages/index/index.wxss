.launch-page {
  min-height: 100vh;
  padding: 56rpx 36rpx;
  background: #f4f8fb;
  color: #172033;
}

.launch-title {
  display: block;
  margin-top: 120rpx;
  font-size: 46rpx;
  font-weight: 900;
}

.launch-note {
  display: block;
  margin-top: 18rpx;
  color: #607488;
  font-size: 27rpx;
}

.launch-button {
  width: 100%;
  height: 88rpx;
  margin-top: 40rpx;
  border-radius: 18rpx;
  background: #1769d2;
  color: #fff;
  font-size: 29rpx;
  font-weight: 900;
}
