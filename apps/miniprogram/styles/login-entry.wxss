.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 32rpx;
  color: #172033;
}

.login-page::before,
.login-page::after {
  content: "";
  position: absolute;
  pointer-events: none;
}

.login-page::before {
  inset: 0;
  background:
    linear-gradient(90deg, transparent 0, transparent 23rpx, rgba(255,255,255,0.22) 24rpx),
    linear-gradient(0deg, transparent 0, transparent 23rpx, rgba(255,255,255,0.16) 24rpx);
  background-size: 48rpx 48rpx;
  opacity: 0.64;
}

.login-page::after {
  left: -120rpx;
  right: -120rpx;
  top: 220rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(70, 212, 214, 0.75), transparent);
  animation: loginScan 3.8s ease-in-out infinite;
}

.role-student {
  background:
    radial-gradient(circle at 18% 12%, rgba(65, 214, 196, 0.24), transparent 34%),
    linear-gradient(160deg, #f3fffb 0%, #eaf7f5 48%, #f7fbff 100%);
}

.role-teacher {
  background:
    radial-gradient(circle at 18% 12%, rgba(108, 169, 255, 0.34), transparent 34%),
    linear-gradient(160deg, #eef6ff 0%, #ddeaff 46%, #f8fbff 100%);
}

.role-classroom {
  background:
    radial-gradient(circle at 18% 12%, rgba(127, 222, 163, 0.34), transparent 34%),
    linear-gradient(160deg, #f6fff8 0%, #e8f5ec 48%, #f7fbff 100%);
}

.login-shell {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-height: calc(100vh - 64rpx);
}

.brand-panel,
.form-panel {
  border: 1rpx solid rgba(96, 132, 148, 0.16);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 50rpx rgba(26, 68, 92, 0.1);
}

.brand-panel {
  position: relative;
  overflow: hidden;
  min-height: 560rpx;
  padding: 34rpx;
}

.brand-panel::before {
  content: "";
  position: absolute;
  inset: 28rpx;
  border: 1rpx solid rgba(58, 124, 151, 0.13);
  border-radius: 20rpx;
}

.brand-copy {
  position: relative;
  z-index: 2;
}

.is-selected .brand-copy {
  opacity: 0;
  height: 0;
  overflow: hidden;
}

.login-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.72);
  color: #24647a;
  font-size: 23rpx;
  font-weight: 800;
}

.login-title {
  display: block;
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: 0;
}

.login-subtitle {
  display: block;
  margin-top: 18rpx;
  color: #526678;
  font-size: 27rpx;
  line-height: 1.55;
}

.brand-stage {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}

.ai-orbit {
  position: absolute;
  width: 310rpx;
  height: 310rpx;
  border: 1rpx solid rgba(44, 148, 164, 0.2);
  border-radius: 999rpx;
  animation: orbitSpin 12s linear infinite;
}

.ai-orbit::before,
.ai-orbit::after {
  content: "";
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #21b8c0;
  box-shadow: 0 0 28rpx rgba(33, 184, 192, 0.55);
}

.ai-orbit::before {
  left: 34rpx;
  top: 44rpx;
}

.ai-orbit::after {
  right: 38rpx;
  bottom: 38rpx;
}

.ai-avatar {
  position: relative;
  z-index: 2;
  width: 230rpx;
  height: 230rpx;
  border-radius: 999rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 46rpx rgba(23, 67, 87, 0.18);
}

.is-selected .ai-avatar {
  transform: translateY(-34rpx) scale(0.84);
}

.selected-hint {
  position: relative;
  z-index: 2;
  margin-top: -30rpx;
  text-align: center;
}

.selected-hint text {
  display: block;
}

.hint-title {
  font-size: 31rpx;
  font-weight: 900;
}

.hint-note {
  margin-top: 8rpx;
  color: #607488;
  font-size: 24rpx;
}

.role-strip {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 12rpx;
}

.role-strip.compact {
  flex-direction: row;
  justify-content: center;
  gap: 12rpx;
}

.role-card {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(88, 120, 142, 0.16);
  border-radius: 20rpx;
  background: rgba(255,255,255,0.76);
}

.role-strip.compact .role-card {
  flex: 1;
  min-height: 84rpx;
  justify-content: center;
  padding: 12rpx;
}

.role-card.active {
  border-color: rgba(30, 167, 183, 0.55);
  box-shadow: 0 12rpx 30rpx rgba(27, 119, 136, 0.14);
  transform: translateY(-4rpx);
}

.role-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
}

.role-strip.compact .role-icon {
  margin-right: 8rpx;
}

.role-icon.student {
  background: linear-gradient(135deg, #1fb8ad, #34d399);
}

.role-icon.teacher {
  background: linear-gradient(135deg, #2f75f6, #63a4ff);
}

.role-icon.classroom {
  background: linear-gradient(135deg, #2da55f, #84cc16);
}

.role-name {
  font-size: 29rpx;
  font-weight: 900;
}

.role-desc {
  display: block;
  margin-top: 6rpx;
  color: #66788a;
  font-size: 23rpx;
  line-height: 1.35;
}

.role-strip.compact .role-desc {
  display: none;
}

.form-panel {
  padding: 30rpx;
}

.form-head {
  margin-bottom: 22rpx;
}

.form-title {
  display: block;
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 900;
}

.form-note {
  display: block;
  margin-top: 12rpx;
  color: #607488;
  font-size: 25rpx;
  line-height: 1.5;
}

.field-label {
  display: block;
  margin: 20rpx 0 10rpx;
  color: #455a6c;
  font-size: 24rpx;
  font-weight: 800;
}

.login-input {
  width: 100%;
  min-height: 86rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(89, 119, 141, 0.18);
  border-radius: 18rpx;
  background: rgba(255,255,255,0.92);
  color: #172033;
  font-size: 29rpx;
}

.login-placeholder {
  color: #9aa8b6;
}

.login-button {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #17a9b5, #2fc7b4);
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 34rpx rgba(25, 158, 171, 0.22);
}

.role-teacher .login-button {
  background: linear-gradient(135deg, #2f75f6, #68a6ff);
  box-shadow: 0 16rpx 34rpx rgba(47, 117, 246, 0.22);
}

.role-classroom .login-button {
  background: linear-gradient(135deg, #238b56, #80c43b);
  box-shadow: 0 16rpx 34rpx rgba(35, 139, 86, 0.2);
}

.link-button {
  width: 100%;
  height: 78rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(87, 116, 138, 0.18);
  border-radius: 18rpx;
  background: rgba(255,255,255,0.64);
  color: #43576a;
  font-size: 27rpx;
  font-weight: 800;
}

.message {
  display: block;
  margin-top: 20rpx;
  color: #b45309;
  font-size: 25rpx;
  line-height: 1.45;
}

@media (min-width: 760px) {
  .login-shell {
    flex-direction: row;
    align-items: stretch;
  }

  .brand-panel {
    flex: 1;
    min-height: calc(100vh - 64rpx);
  }

  .form-panel {
    flex: 0 0 420rpx;
  }
}

@keyframes loginScan {
  0%, 100% {
    transform: translateY(-90rpx);
    opacity: 0.2;
  }
  50% {
    transform: translateY(190rpx);
    opacity: 0.75;
  }
}

@keyframes orbitSpin {
  to {
    transform: rotate(360deg);
  }
}
