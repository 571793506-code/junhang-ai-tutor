{
  "name": "junhang-ai-tutor",
  "private": true,
  "version": "0.1.0",
  "description": "AI after-school tutoring system for Junhang.",
  "scripts": {
    "dev": "node scripts/run-with-env.mjs npm run dev --workspace apps/web",
    "dev:api": "node scripts/run-with-env.mjs npm run dev --workspace apps/api",
    "dev:web:lan": "scripts\\dev-web-lan.cmd",
    "dev:api:lan": "scripts\\dev-api-lan.cmd",
    "start:api": "node scripts/run-with-env.mjs npm run start --workspace apps/api",
    "api:autostart:install": "scripts\\install-api-autostart.cmd",
    "api:autostart:start": "scripts\\start-api-autostart.cmd",
    "api:autostart:status": "scripts\\status-api-autostart.cmd",
    "api:autostart:stop": "scripts\\stop-api-autostart.cmd",
    "api:startup:install": "scripts\\install-api-startup-folder.cmd",
    "api:startup:start": "scripts\\start-api-startup-folder.cmd",
    "api:startup:uninstall": "scripts\\uninstall-api-startup-folder.cmd",
    "api:user-run:install": "node scripts/install-api-user-run.mjs",
    "api:user-run:uninstall": "node scripts/uninstall-api-user-run.mjs",
    "api:start-if-needed": "scripts\\start-api-if-needed.cmd",
    "codex:open": "scripts\\open-codex-with-api.cmd",
    "codex:launcher:install": "node scripts/install-codex-api-launcher.mjs",
    "check:api": "node scripts/run-with-env.mjs npm run check --workspace apps/api",
    "verify": "node scripts/run-with-env.mjs npm run check:encoding && node scripts/run-with-env.mjs npm run check:miniprogram-js && node scripts/run-with-env.mjs npm run lint --if-present && node scripts/run-with-env.mjs npm run typecheck --if-present && node scripts/run-with-env.mjs npm run test --if-present",
    "audit:reference": "node scripts/audit-reference.mjs",
    "content:markdown": "node scripts/convert-to-markdown.mjs",
    "content:index": "node scripts/build-content-index.mjs",
    "startup:report": "node scripts/startup-mode-report.mjs",
    "textbooks:scan": "node scripts/scan-textbook-assets.mjs --write",
    "textbooks:import": "node scripts/run-with-env.mjs node scripts/import-textbook-assets.mjs",
    "check:ai": "node scripts/check-ai-services.mjs",
    "check:feishu": "node scripts/check-feishu-app.mjs",
    "check:services": "node scripts/service-smoke.mjs",
    "workspace:guard": "node scripts/workspace-guardian.mjs",
    "workspace:archive-residue": "node scripts/workspace-archive-residue.mjs",
    "check:workspace-guardian": "node --test scripts/workspace-guardian.test.mjs",
    "check:generation:blueprint": "node scripts/generation-blueprint-check.mjs",
    "check:generation:quality:quiz": "node scripts/run-with-env.mjs node scripts/generation-quality-check.mjs",
    "check:generation:quality:formal": "node scripts/run-with-env.mjs node scripts/generation-quality-check.mjs --formal",
    "check:gpt56": "node scripts/gpt56-capability-check.mjs",
    "check:grading:quality": "node scripts/grading-quality-check.mjs",
    "check:generation:layout": "node scripts/generation-layout-check.mjs",
    "check:web:generation-workbench": "node scripts/web-generation-workbench-ui.test.mjs",
    "check:content-context": "node scripts/content-context-e2e.mjs",
    "check:content-upload-ui": "node scripts/content-upload-ui-contract.mjs",
    "check:teaching-content": "node scripts/teaching-content-check.mjs",
    "check:teaching-content:full": "node scripts/teaching-content-check.mjs",
    "check:miniprogram-http": "node scripts/miniprogram-http-check.mjs",
    "check:miniprogram-js": "node scripts/check-miniprogram-js.mjs",
    "check:miniapp1": "node scripts/check-miniapp1.mjs",
    "check:flow:light": "scripts\\run-flow-light.cmd",
    "check:wechat-devtools": "scripts\\wechat-devtools-compile.cmd",
    "open:wechat-devtools": "scripts\\wechat-devtools-open.cmd",
    "cleanup:selfcheck": "node scripts/run-with-env.mjs node scripts/cleanup-selfcheck-records.mjs",
    "sync:miniapp1": "node scripts/sync-miniprogram-to-miniapp.mjs",
    "check:flow": "node scripts/system-flow-check.mjs",
    "check:encoding": "node scripts/encoding-guard-check.mjs",
    "check:encoding:generated": "node scripts/encoding-guard-check.mjs --include-generated",
    "check:encoding:history": "node scripts/encoding-guard-check.mjs --history --write-report",
    "fix:encoding": "node scripts/encoding-guard-check.mjs --fix",
    "fix:encoding:history": "node scripts/encoding-guard-check.mjs --history --fix --write-report",
    "db:generate": "node scripts/run-with-env.mjs npm run db:generate --workspace packages/db",
    "db:migrate": "node scripts/run-with-env.mjs npm run db:migrate --workspace packages/db",
    "db:validate": "node scripts/run-with-env.mjs npm run db:validate --workspace packages/db",
    "db:seed": "node scripts/run-with-env.mjs npm run db:seed --workspace packages/db",
    "db:up": "docker compose -f infra/docker-compose.postgres.yml up -d"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@larksuite/cli": "^1.0.36",
    "prisma": "^6.19.0"
  }
}
