generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActorType {
  STUDENT
  GUARDIAN
  TEACHER
  SYSTEM
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
  MIDTERM
  FINAL
  TERM
}

enum TaskStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REVIEWED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  NEEDS_REVIEW
  RETURNED
}

enum AccessCodeStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum EnrollmentStatus {
  TRIAL
  ACTIVE
  PAUSED
  WITHDRAWN
}

enum DeviceStatus {
  BOUND
  PENDING
  DISABLED
}

enum BroadcastStatus {
  PENDING
  PLAYED
  ARCHIVED
}

enum DictationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ReadingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ClassroomQaMode {
  GUIDED_THINKING
  KNOWLEDGE_EXPLANATION
}

model Student {
  id                   String                     @id @default(cuid())
  displayName          String
  grade                String?
  school               String?
  className            String?
  textbookVersion      String?
  enrollmentStatus     EnrollmentStatus           @default(ACTIVE)
  loginEnabled         Boolean                    @default(true)
  currentSessionJti    String?
  currentSessionAt     DateTime?
  responsibleTeacherId String?
  notes                String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  responsibleTeacher   Teacher?                   @relation("ResponsibleStudents", fields: [responsibleTeacherId], references: [id])
  accessCodes          StudentAccessCode[]
  teacherAssignments   TeacherStudentAssignment[]
  guardians            StudentGuardian[]
  classes              ClassStudent[]
  tasks                LearningTask[]
  attempts             TaskAttempt[]
  dictations           DictationSession[]
  qaSessions           QaSession[]
  vocabulary           VocabularyRecord[]
  submissions          Submission[]
  mistakes             MistakeRecord[]
  behaviorEvents       BehaviorEvent[]
  profiles             StudentProfile[]
  reports              StudentReport[]
  voiceInteractions    VoiceInteraction[]
}

model Guardian {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  email     String?
  openId    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  students  StudentGuardian[]
}

model Teacher {
  id                        String                     @id @default(cuid())
  name                      String
  phone                     String?
  email                     String?
  openId                    String?
  role                      String?
  status                    String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  accessCodes               TeacherAccessCode[]
  createdStudentAccessCodes StudentAccessCode[]        @relation("StudentAccessCodeCreator")
  responsibleStudents       Student[]                  @relation("ResponsibleStudents")
  studentAssignments        TeacherStudentAssignment[]
  classroomDevices          ClassroomDevice[]
  broadcasts                TaskBroadcast[]
  dictationTasks            DictationTask[]
  readingTasks              ReadingTask[]
  classes                   ClassTeacher[]
  tasks                     LearningTask[]
}

model StudentAccessCode {
  id                 String           @id @default(cuid())
  studentId          String
  codeHash           String
  codePreview        String?
  status             AccessCodeStatus @default(ACTIVE)
  createdByTeacherId String?
  createdAt          DateTime         @default(now())
  disabledAt         DateTime?
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdByTeacher   Teacher?         @relation("StudentAccessCodeCreator", fields: [createdByTeacherId], references: [id])

  @@unique([codeHash])
  @@index([studentId, status])
}

model TeacherAccessCode {
  id         String           @id @default(cuid())
  teacherId  String
  codeHash   String
  codePreview String?
  roleScope  String?
  status     AccessCodeStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  disabledAt DateTime?
  teacher    Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([codeHash])
  @@index([teacherId, status])
}

model TeacherStudentAssignment {
  id         String    @id @default(cuid())
  teacherId  String
  studentId  String
  source     String?
  activeFrom DateTime  @default(now())
  activeTo   DateTime?
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([studentId])
}

model StudentGuardian {
  studentId  String
  guardianId String
  relation   String?
  createdAt  DateTime @default(now())
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model Class {
  id        String         @id @default(cuid())
  name      String
  term      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  students  ClassStudent[]
  teachers  ClassTeacher[]
}

model ClassStudent {
  classId   String
  studentId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
}

model ClassTeacher {
  classId   String
  teacherId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classId, teacherId])
}

model Subject {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  knowledgePoints KnowledgePoint[]
  assignments     Assignment[]
  tasks           LearningTask[]
}

model KnowledgePoint {
  id        String           @id @default(cuid())
  subjectId String
  parentId  String?
  code      String?
  name      String
  grade     String?
  metadata  Json?
  parent    KnowledgePoint?  @relation("KnowledgeTree", fields: [parentId], references: [id])
  children  KnowledgePoint[] @relation("KnowledgeTree")
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  mistakes  MistakeRecord[]
}

model TextbookAsset {
  id        String   @id @default(cuid())
  subject   String
  edition   String?
  grade     String?
  volume    String?
  title     String
  source    String?
  path      String?
  url       String?
  hash      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeSource {
  id                   String            @id @default(cuid())
  title                String
  sourceType           String
  subject              String?
  grade                String?
  edition              String?
  volume               String?
  unit                 String?
  lesson               String?
  sourceUrl            String?
  sourcePath           String?
  markdownPath         String?
  licenseStatus        String            @default("REVIEW_REQUIRED")
  reviewStatus         String            @default("PENDING")
  allowedForGeneration Boolean           @default(false)
  confidence           Float?
  summary              String?
  metadata             Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  chunks               KnowledgeChunk[]
  reviews              SourceReview[]

  @@index([subject, grade])
  @@index([sourceType, reviewStatus])
  @@index([allowedForGeneration])
}

model KnowledgeChunk {
  id              String          @id @default(cuid())
  sourceId        String
  orderIndex      Int
  text            String
  preview         String?
  knowledgePoints Json?
  metadata        Json?
  createdAt       DateTime        @default(now())
  source          KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, orderIndex])
}

model SourceReview {
  id          String          @id @default(cuid())
  sourceId    String
  teacherId   String?
  status      String
  note        String?
  createdAt   DateTime        @default(now())
  source      KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt])
  @@index([teacherId])
}

model LearningTask {
  id          String        @id @default(cuid())
  studentId   String?
  teacherId   String?
  subjectId   String?
  title       String
  description String?
  status      TaskStatus    @default(DRAFT)
  dueAt       DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  student     Student?      @relation(fields: [studentId], references: [id])
  teacher     Teacher?      @relation(fields: [teacherId], references: [id])
  subject     Subject?      @relation(fields: [subjectId], references: [id])
  attempts    TaskAttempt[]
}

model TaskAttempt {
  id              String       @id @default(cuid())
  taskId          String
  studentId       String
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  score           Float?
  result          Json?
  task            LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model DictationSession {
  id          String   @id @default(cuid())
  studentId   String
  subject     String
  sourceTitle String?
  prompt      String
  answer      String?
  result      Json?
  score       Float?
  createdAt   DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model QaSession {
  id         String    @id @default(cuid())
  studentId  String?
  modelRunId String?
  subject    String?
  question   String
  answer     String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  student    Student?  @relation(fields: [studentId], references: [id])
  modelRun   ModelRun? @relation(fields: [modelRunId], references: [id])
}

model VocabularyRecord {
  id        String   @id @default(cuid())
  studentId String
  term      String
  content   Json
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String           @id @default(cuid())
  subjectId   String?
  title       String
  grade       String?
  difficulty  String?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  subject     Subject?         @relation(fields: [subjectId], references: [id])
  items       AssignmentItem[]
  submissions Submission[]
}

model AssignmentItem {
  id           String     @id @default(cuid())
  assignmentId String
  orderIndex   Int
  itemType     String
  prompt       String
  answer       Json?
  rubric       Json?
  metadata     Json?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(SUBMITTED)
  content      Json?
  submittedAt  DateTime         @default(now())
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grading      GradingResult?
}

model GradingResult {
  id           String     @id @default(cuid())
  submissionId String     @unique
  modelRunId   String?
  score        Float?
  result       Json
  needsReview  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  modelRun     ModelRun?  @relation(fields: [modelRunId], references: [id])
}

model MistakeRecord {
  id               String          @id @default(cuid())
  studentId        String
  knowledgePointId String?
  subject          String
  prompt           String
  studentAnswer    String?
  correctAnswer    String?
  cause            String?
  masteryResolved  Boolean         @default(false)
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  knowledgePoint   KnowledgePoint? @relation(fields: [knowledgePointId], references: [id])
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model BehaviorEvent {
  id              String    @id @default(cuid())
  studentId       String?
  actorType       ActorType
  feature         String
  action          String
  occurredAt      DateTime  @default(now())
  durationSeconds Int?
  metadata        Json?
  student         Student?  @relation(fields: [studentId], references: [id])
}

model ClassroomDevice {
  id                 String             @id @default(cuid())
  label              String
  bindingCodeHash    String?
  bindingCodePreview String?
  grade              String?
  className          String?
  teacherId          String?
  status             DeviceStatus       @default(BOUND)
  unlocked           Boolean            @default(false)
  unlockedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  teacher            Teacher?           @relation(fields: [teacherId], references: [id])
  broadcasts         TaskBroadcast[]
  dictationTasks     DictationTask[]
  readingTasks       ReadingTask[]
  voiceInteractions  VoiceInteraction[]
}

model TaskBroadcast {
  id        String          @id @default(cuid())
  deviceId  String
  teacherId String?
  subject   String?
  title     String
  content   String?
  voiceText String
  status    BroadcastStatus @default(PENDING)
  createdAt DateTime        @default(now())
  playedAt  DateTime?
  metadata  Json?
  device    ClassroomDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  teacher   Teacher?        @relation(fields: [teacherId], references: [id])
}

model DictationTask {
  id              String          @id @default(cuid())
  deviceId        String
  teacherId       String?
  grade           String?
  className       String?
  subject         String
  title           String
  difficulty      String?
  repeats         Int             @default(2)
  intervalSeconds Int             @default(10)
  status          DictationStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
  device          ClassroomDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  teacher         Teacher?        @relation(fields: [teacherId], references: [id])
  items           DictationItem[]
}

model DictationItem {
  id              String        @id @default(cuid())
  dictationTaskId String
  orderIndex      Int
  text            String
  hint            String?
  metadata        Json?
  task            DictationTask @relation(fields: [dictationTaskId], references: [id], onDelete: Cascade)
}

model ReadingTask {
  id          String          @id @default(cuid())
  deviceId    String
  teacherId   String?
  grade       String?
  className   String?
  subject     String
  title       String
  passage     String
  focusItems  Json
  supportNote String?
  status      ReadingStatus   @default(PENDING)
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  device      ClassroomDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  teacher     Teacher?        @relation(fields: [teacherId], references: [id])
}

model VoiceInteraction {
  id            String           @id @default(cuid())
  deviceId      String
  studentId     String?
  modelRunId    String?
  mode          ClassroomQaMode?
  transcript    String
  answerSummary String?
  metadata      Json?
  occurredAt    DateTime         @default(now())
  device        ClassroomDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  student       Student?         @relation(fields: [studentId], references: [id])
  modelRun      ModelRun?        @relation(fields: [modelRunId], references: [id])
}

model StudentProfile {
  id        String   @id @default(cuid())
  studentId String
  snapshot  Json
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentReport {
  id        String     @id @default(cuid())
  studentId String
  type      ReportType
  periodKey String
  title     String
  content   String
  metadata  Json?
  createdAt DateTime   @default(now())
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model GeneratedAsset {
  id        String   @id @default(cuid())
  kind      String
  title     String
  path      String?
  url       String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model ModelRun {
  id                String             @id @default(cuid())
  provider          String
  model             String?
  skill             String?
  inputSummary      String?
  outputSummary     String?
  status            String
  latencyMs         Int?
  costEstimate      Float?
  metadata          Json?
  createdAt         DateTime           @default(now())
  qaSessions        QaSession[]
  gradingResults    GradingResult[]
  voiceInteractions VoiceInteraction[]
}
